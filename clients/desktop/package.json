{
  "name": "@ovs/desktop",
  "version": "0.2.4",
  "private": true,
  "description": "OpenVideoServer desktop client: configuration, project editing, media ingest and Live Mode",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "npm run build && electron .",
    "overflow": "npm run build && electron tools/overflow",
    "press": "npm run build && electron tools/press",
    "ffmpeg": "bash ../../tools/build-ffmpeg.sh --profile client",
    "dist:win": "node build.mjs --release && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@ovs/schema": "*",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "ffmpeg-static": "^5.3.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "author": "testbild.media",
  "license": "Apache-2.0"
}
