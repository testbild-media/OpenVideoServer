{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SetLockRequest",
  "description": "Locks one effect or generator where it is, or unlocks it.\n\n**Administrators only, and the only way a lock changes** (owner, 2026-10-19). A locked effect or generator cannot be removed, moved or put in another order by anybody, an administrator included; unlocking is this request, made deliberately, before any of those. A show sent whole carries the locks it already has whatever its copy says, so an editor's draft from before a lock cannot undo one by being saved.\n\nWhat it is doing is not locked: its values follow the patch like any other module's, and switching an effect on or off stays everybody's.",
  "type": "object",
  "required": [
    "locked",
    "target"
  ],
  "properties": {
    "locked": {
      "description": "Locked, or not.",
      "type": "boolean"
    },
    "target": {
      "description": "What to lock or unlock.",
      "allOf": [
        {
          "$ref": "#/definitions/LockTarget"
        }
      ]
    }
  },
  "definitions": {
    "EffectInstanceId": {
      "description": "EffectInstanceId (ULID, 26 characters)",
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "GeneratorInstanceId": {
      "description": "GeneratorInstanceId (ULID, 26 characters)",
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "LockTarget": {
      "description": "What a lock is put on: one effect, or one generator.",
      "oneOf": [
        {
          "description": "One effect instance, on a layer or on a slot.",
          "type": "object",
          "required": [
            "effect_instance_id",
            "kind"
          ],
          "properties": {
            "effect_instance_id": {
              "description": "The instance.",
              "allOf": [
                {
                  "$ref": "#/definitions/EffectInstanceId"
                }
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "effect"
              ]
            }
          }
        },
        {
          "description": "One generator instance, in its slot.",
          "type": "object",
          "required": [
            "generator_instance_id",
            "kind"
          ],
          "properties": {
            "generator_instance_id": {
              "description": "The instance.",
              "allOf": [
                {
                  "$ref": "#/definitions/GeneratorInstanceId"
                }
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "generator"
              ]
            }
          }
        }
      ]
    }
  }
}
