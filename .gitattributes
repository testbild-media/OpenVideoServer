# Production is Debian; development is Windows. Normalise to LF in the
# repository so a shell script or a generated schema never reaches Linux with
# CRLF line endings.
* text=auto eol=lf

# PowerShell is the exception: it wants CRLF on Windows.
*.ps1 text eol=crlf

# The grandMA1 fixture types, and the owner's desk exports beside them, byte
# for byte: a grandMA1 ends its lines with CR CR LF, which git would otherwise
# rewrite, and these are written the way his desk writes them.
reference/grandma1/*.TXT -text
reference/grandma1/desk/** -text

# Binary assets must never be touched.
*.png binary
*.jpg binary
*.ico binary
*.mov binary
*.mp4 binary
