[Unit]
Description=OpenVideoServer: make the NVIDIA compute device before the renderer starts
Documentation=https://github.com/testbild-media/OpenVideoServer

# NVDEC and NVENC are reached through CUDA, and CUDA needs `/dev/nvidia-uvm`.
# Nothing creates it at boot: the module loads on demand, and the node is made
# by `nvidia-modprobe`, which is setuid root for exactly this. Until something
# asks, it is not there, and `cuInit` fails with `CUDA_ERROR_UNKNOWN` -- every
# clip then decodes on the processor and every preview is encoded in software,
# with one line in the renderer's log to say so.
#
# **A unit of its own, as root, and finished before the renderer starts.** This
# used to be an `ExecStartPre=-` line in `ovs-renderer.service`, and it never
# worked: it ran inside the renderer's sandbox, where `NoNewPrivileges=yes`
# throws away the setuid bit and `ProtectKernelModules=yes` forbids loading a
# module at all, and the leading `-` swallowed the failure. Found on the
# location server on 2026-10-18, where the module was not loaded 25 minutes
# after boot.
#
# Why not run it as root inside the renderer's own unit (`ExecStartPre=+`)?
# **Not measured, so read this as the reason for being careful rather than as a
# fact:** the renderer's device list names `char-nvidia-uvm`, and systemd turns
# that name into a device number when it sets the unit's cgroup up, which is
# before any of its commands run. If that is so, a module loaded by the unit's
# own first command arrives too late for its own device list, and CUDA fails
# the same way with the node sitting right there. A unit that has finished
# before the renderer is even started cannot have that problem either way.
#
# On a machine without the NVIDIA tool -- an AMD or Intel one -- this is
# skipped, not failed, and the renderer starts exactly as before.
ConditionPathExists=/usr/bin/nvidia-modprobe
Before=ovs-renderer.service

[Service]
Type=oneshot
# Stays "active" once it has run, so a renderer that restarts does not ask for
# it again: the module, once loaded, stays loaded.
RemainAfterExit=yes
# `-u` loads the unified-memory module and makes its nodes, `-c 0` makes the
# card's own. The leading `-` keeps a refusal here from failing the boot; it is
# in the journal under this unit's name, which is where somebody looks.
ExecStart=-/usr/bin/nvidia-modprobe -u -c 0
